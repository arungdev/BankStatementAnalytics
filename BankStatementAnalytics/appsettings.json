{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Port the published/Release app (Production environment) listens on. Dev overrides
  // this via launchSettings / appsettings.Development.json to stay on 5000.
  "Urls": "http://localhost:5080",
  "Database": {
    "Provider": "Postgres",
    "Embedded": true,
    // Only used when "Embedded" is false. Leave the password blank here — never commit a real
    // credential. At deploy time, override the whole string via the environment variable
    // Database__PostgresConnectionString (see NHibernateHelper).
    "PostgresConnectionString": "Host=localhost;Port=5432;Database=bankstatements;Username=postgres;Password="
  }
}
