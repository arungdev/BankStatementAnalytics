@model BankStatementAnalytics.Dtos.CounterPartyDto

<h2>@(Model.FriendlyName ?? Model.Name)</h2>
<p class="text-muted">@Model.Category @(Model.SubCategory != null ? $"/ {Model.SubCategory}" : "")</p>

<!-- UPI IDs -->
<div class="card mb-3">
    <div class="card-header fw-bold">UPI IDs</div>
    <ul class="list-group list-group-flush">
        @foreach (var upi in Model.UpiIds)
        {
            <li class="list-group-item">@upi</li>
        }
        @if (!Model.UpiIds.Any())
        {
            <li class="list-group-item text-muted">No UPI IDs recorded</li>
        }
    </ul>
</div>

<!-- Transactions -->
<table class="table table-sm table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Date</th>
            <th>Mode</th>
            <th>UPI Ref</th>
            <th class="text-danger">Debit</th>
            <th class="text-success">Credit</th>
            <th>Balance</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Transactions)
        {
            <tr class="@(t.Debit > 0 ? "table-danger" : "table-success")">
                <td>@t.TransactionDate.ToString("dd-MM-yyyy")</td>
                <td>@t.Mode</td>
                <td>@t.UpiReference</td>
                <td class="text-danger">
                    @if (t.Debit > 0)
                    {
                        @string.Format("{0:N2}", t.Debit)
                    }
                </td>
                <td class="text-success">
                    @if (t.Credit > 0)
                    {
                        @string.Format("{0:N2}", t.Credit)
                    }
                </td>
                <td>@string.Format("{0:N2}", t.Balance)</td>
            </tr>
        }
    </tbody>
    <tfoot class="fw-bold table-secondary">
        @{
            var td = Model.Transactions.Sum(x => x.Debit);
            var tc = Model.Transactions.Sum(x => x.Credit);
        }
        <tr>
            <td colspan="3" class="text-end">Total:</td>
            <td class="text-danger">@string.Format("{0:N2}", td)</td>
            <td class="text-success">@string.Format("{0:N2}", tc)</td>
            <td></td>
        </tr>
    </tfoot>
</table>