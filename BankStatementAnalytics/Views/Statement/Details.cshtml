@model List<BankStatementAnalytics.Dtos.TransactionDto>

<h2>@ViewBag.AccountName — @ViewBag.Bank Transactions</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card p-3 mb-3">
    <h4>Upload Statement</h4>
    <form asp-controller="Statement" asp-action="UploadForAccount"
          method="post" enctype="multipart/form-data">
        <input type="hidden" name="accountId" value="@ViewBag.AccountId" />
        <input type="file" name="file" class="form-control mb-2" />
        <button type="submit" class="btn btn-primary">Upload</button>
    </form>
</div>

<hr />

@{
    var totalDebit = Model.Sum(x => x.Debit);
    var totalCredit = Model.Sum(x => x.Credit);
}

<table class="table table-bordered table-striped table-sm">
    <thead class="table-dark">
        <tr>
            <th>Date</th>
            <th>Counter Party</th>
            <th>Category</th>
            <th>Mode</th>
            <th>UPI Ref</th>
            <th class="text-danger">Debit</th>
            <th class="text-success">Credit</th>
            <th>Balance</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.Debit > 0 ? "table-danger" : "table-success")">
                <td>@item.TransactionDate.ToString("dd-MM-yyyy")</td>
                <td>@(item.CounterParty ?? "-")</td>
                <td>@(item.Category ?? "-")</td>
                <td>@item.Mode</td>
                <td>@item.UpiReference</td>
                <td class="text-danger">
                    @if (item.Debit > 0)
                    {
                        @string.Format("{0:N2}", item.Debit)
                    }
                </td>
                <td class="text-success">
                    @if (item.Credit > 0)
                    {
                        @string.Format("{0:N2}", item.Credit)
                    }
                </td>
                <td>@string.Format("{0:N2}", item.Balance)</td>
            </tr>
        }
    </tbody>
    <tfoot class="table-secondary fw-bold">
        <tr>
            <td colspan="5" class="text-end">Total:</td>
            <td class="text-danger">@string.Format("{0:N2}", totalDebit)</td>
            <td class="text-success">@string.Format("{0:N2}", totalCredit)</td>
            <td></td>
        </tr>
    </tfoot>
</table>