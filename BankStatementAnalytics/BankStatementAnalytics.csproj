<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BankStatementAnalytics</RootNamespace>
    <!-- Windows icon embedded in the published exe; also drives the installer's
         UninstallDisplayIcon and Start-menu/desktop shortcut icons (all point at the exe). -->
    <ApplicationIcon>icons\AppIcon.ico</ApplicationIcon>
    <!-- Single source of truth for the app/installer version - bump this per release. -->
    <Version>1.0.0</Version>
    <!-- Disable the SDK's static-web-assets Brotli/gzip precompression. The React client is built
         straight into wwwroot with hashed filenames (Vite emptyOutDir), and that hash churn desyncs
         the compression fingerprint cache in obj\ across repeated publishes, failing the build with
         "The asset ... can not be found". We also serve wwwroot via plain app.UseStaticFiles() (not
         MapStaticAssets), so the generated .br/.gz twins were never served anyway - pure overhead. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="log4net.config" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NHibernate" Version="5.6.1" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <!-- PDF statement text extraction (pure managed - safe for single-file publish). -->
    <PackageReference Include="PdfPig" Version="0.1.11" />
    <!-- Lets the published exe run as a Windows service (no-op when launched interactively). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <!-- Transitive dependency of Common.Framework's logging layer. When Common.Framework was a
         source ProjectReference this flowed in automatically; against the vendored DLL below it
         must be declared explicitly or log4net.dll is missing at runtime. -->
    <PackageReference Include="log4net" Version="3.3.1" />
  </ItemGroup>

	<!-- Common.Framework is a PRIVATE dependency (see README). Instead of a source ProjectReference
	     to the git submodule, we reference a vendored, prebuilt DLL committed under lib/ so this repo
	     compiles without access to the private source. Rebuild + recopy lib/Common.Framework.dll when
	     the framework changes. -->
	<ItemGroup>
		<Reference Include="Common.Framework">
			<HintPath>lib\Common.Framework.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup>
    <Folder Include="Views\Shared\" />
    <Folder Include="Views\Statement\" />
  </ItemGroup>

	<ItemGroup>
	  <None Include="log4net.config" />
	</ItemGroup>

  <ItemGroup>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Ship the Windows-service register/unregister helpers as LOOSE files next to the
       published exe, so the Inno installer packages them into {app} and can invoke them.
       Done as a post-publish copy (not <None CopyToPublishDirectory>) because
       IncludeAllContentForSelfExtract=true would otherwise bundle them INTO the single-file
       exe (extracted to temp at runtime) instead of leaving them alongside it. -->
  <Target Name="CopyServiceScriptsToPublish" AfterTargets="Publish">
    <Copy SourceFiles="Installer\install-service.bat;Installer\uninstall-service.bat" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <!-- Ship log4net.config as a LOOSE file next to the exe too (same reason as the scripts:
         IncludeAllContentForSelfExtract bundles it into the exe otherwise, so it would be
         extracted to a temp folder instead of living, visible/editable, in the install dir).
         Log.Initialize loads it from the install directory - see Common.Framework Logger. -->
    <Copy SourceFiles="log4net.config" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
	<!--
	<ItemGroup>
		<Content Update="wwwroot\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
-->
  <!-- Automatically build the React client and output to wwwroot only in Release (production) mode.
       Must run BEFORE static-web-assets discovery (ResolveProjectStaticWebAssets), not just before
       Build: Vite empties wwwroot and re-emits hashed filenames on every build, so if discovery runs
       first it caches the OLD hashes in obj\, and the publish copy step then chases files that no
       longer exist ("MSB3030 ... could not be copied because it was not found"). Ordering the client
       build ahead of discovery guarantees the manifest is built from the freshly-emitted hashes. -->
  <Target Name="BuildReactClient" BeforeTargets="Build;ResolveProjectStaticWebAssets" Condition="'$(Configuration)' == 'Release'">
    <Message Importance="high" Text="Installing npm dependencies and building React client..." />
    <Exec Command="npm install" WorkingDirectory="..\Client" />
    <Exec Command="npm run build" WorkingDirectory="..\Client" />
  </Target>

  <!-- Copies the bundled embedded-PostgreSQL binaries (Common.Framework/Installer/PgBundle) into
       the build output so local dev (dotnet build/run) can use Database:Embedded=true too, not
       just an installed copy. Skipped once already present, so a clean build pays the ~150MB
       copy cost once, not on every incremental build. -->
  <Target Name="CopyPgsqlBundle" AfterTargets="Build" Condition="!Exists('$(OutDir)pgsql\bin\postgres.exe') And Exists('$(MSBuildProjectDirectory)\..\Common.Framework\Installer\PgBundle')">
    <Message Importance="high" Text="Copying embedded PostgreSQL bundle to output (one-time, ~150MB)..." />
    <Exec Command="robocopy &quot;$(MSBuildProjectDirectory)\..\Common.Framework\Installer\PgBundle&quot; &quot;$(OutDir)pgsql&quot; /E /NFL /NDL /NJH /NJS /NC /NS" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="RobocopyExitCode" />
    </Exec>
    <Error Condition="'$(RobocopyExitCode)' &gt;= '8'" Text="robocopy failed while copying the PostgreSQL bundle (exit code $(RobocopyExitCode))." />
  </Target>

</Project>
