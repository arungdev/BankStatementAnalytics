# Non-secret project settings for Common.Framework's deployment module.
DEPLOY_IMAGE=arungs125/bankstatementanalytics
DEPLOY_VERSION=4.0.0
DEPLOY_DIRECTORY=bankstatementanalytics
APP_SERVICE=bankstatementanalytics
DB_SERVICE=db
DB_NAME=bankstatements
DB_USER=bankstatements
DB_OPERATOR_USER=bsa_operator
SESSION_DIRECTORY=/app/Sessions
REQUIRE_BACKUP_ENCRYPTION=true
BACKUP_RECIPIENTS_FILE=secrets/backup-recipients.txt
APP_HOST_PORT=8080
DATA_ROOT=/app
DATA_DIRECTORIES=Data,Uploads
HEALTH_URL=http://127.0.0.1:8080/health
SETUP_STATUS_URL=http://127.0.0.1:8080/api/auth/status
HTTPS_PROFILE=https
SUPPORTED_ARCH=x86_64
